# Copy to .env (never commit .env). Every value has a sensible default except the API key.

# --- Claude ---
ANTHROPIC_API_KEY=            # dedicated "jack-o-intern" Console key, monthly spend cap set
MODEL=claude-haiku-5-5
LLM_TIMEOUT_S=8
LLM_THINKING=off              # off = steadiest latency; adaptive = may think on harder questions

# --- Wake word ---
WAKE_ENGINE=openwakeword      # or porcupine (fallback; needs PICOVOICE_ACCESS_KEY + a .ppn file)
WAKE_MODEL_PATH=models/hey_jack.onnx
WAKE_THRESHOLD=0.5            # tune on site with tools/wake_test.py
WAKE_COOLDOWN_S=2
PICOVOICE_ACCESS_KEY=

# --- Audio devices (substring of the name shown by tools/list_devices.py) ---
MIC_DEVICE=Jabra
SPEAKER_DEVICE=Jabra

# --- Speech-to-text ---
WHISPER_MODEL=base.en
WHISPER_DIR=models/whisper

# --- Voice ---
PIPER_VOICE_PATH=models/piper/en_US-ryan-medium.onnx
PIPER_LENGTH_SCALE=1.1        # higher = slower = more deadpan
PIPER_EXE=                    # optional: full path to piper.exe if the Python package fails

# --- Listening ---
VAD_AGGRESSIVENESS=2          # 0-3, higher = stricter about what counts as speech
SILENCE_END_MS=800            # this much quiet ends a question
MAX_RECORD_S=8                # longer than this plays an err_too_long line
FIRST_LISTEN_S=5              # after "Hey Jack", wait this long for the question
FOLLOWUP_WINDOW_S=8           # after answering, listen this long for a follow-up (no wake word)
MAX_TURNS=4                   # per visitor

# --- Contest day ---
VOTING_START=12:00
VOTING_END=15:00

# --- Logging ---
LOG_TRANSCRIPTS=false         # true only while testing; false on Oct 30
LOG_DIR=logs
CACHE_DIR=cache

# --- Offline model loading ---
# Leave 0 until setup.ps1 has downloaded models, then set 1 so event day only needs api.anthropic.com.
HF_HUB_OFFLINE=0
